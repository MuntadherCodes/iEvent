{$DOMAIN} {
	# gzip everything except the notification bell's Server-Sent-Events stream:
	# the encoder buffers small writes, which would hold live events back.
	@notsse not header Accept text/event-stream*
	encode @notsse gzip
	# flush_interval -1 streams responses as they arrive, which the
	# notification bell's Server-Sent-Events channel (/api/notifications/stream)
	# needs; it costs nothing for ordinary pages.
	reverse_proxy app:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# X-Frame-Options is set by the app itself: DENY everywhere except the
		# embeddable /e/** widget page, which must be frameable on other sites.
		# Forcing it here would break the widget's iframe mode.
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Convenience host for organizers: console.<domain> → the host dashboard.
console.{$DOMAIN} {
	redir https://{$DOMAIN}/host{uri} permanent
}
