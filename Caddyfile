{$DOMAIN} {
	# R34: JSON access log on stdout (docker compose logs proxy). Needed to find
	# who is hammering the site: Search Console showed 0 Singapore visitors while
	# GA4 showed dozens at once, i.e. a headless crawler, and without a request
	# log there was no way to get its IP ranges. Field names: request.remote_ip
	# and request.headers.User-Agent.
	log {
		output stdout
		format json
	}

	# R34: IP/CIDR blocklist, edited without touching this file. See caddy/blocklist.caddy
	# (the ./caddy directory is mounted at /etc/caddy/conf.d by docker-compose.staging.yml;
	# a directory mount, so an editor that rewrites the file is still seen by `caddy reload`)
	# and DEPLOY.md "Blocking a bot".
	import /etc/caddy/conf.d/blocklist.caddy

	# gzip everything except the notification bell's Server-Sent-Events stream:
	# the encoder buffers small writes, which would hold live events back.
	@notsse not header Accept text/event-stream*
	encode @notsse gzip
	# flush_interval -1 streams responses as they arrive, which the
	# notification bell's Server-Sent-Events channel (/api/notifications/stream)
	# needs; it costs nothing for ordinary pages.
	reverse_proxy app:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# X-Frame-Options is set by the app itself: DENY everywhere except the
		# embeddable /e/** widget page, which must be frameable on other sites.
		# Forcing it here would break the widget's iframe mode.
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# R34: one host in the index. Search Console listed https://www.{$DOMAIN}/... pages
# next to the bare domain; the permanent redirect folds them back (and Caddy
# obtains the certificate for the www name so the redirect itself is HTTPS).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Convenience host for organizers: console.<domain> → the host dashboard.
console.{$DOMAIN} {
	redir https://{$DOMAIN}/host{uri} permanent
}
