# iEvent local environment — copy to .env and adjust. NEVER commit .env.
# Run everything with:  docker compose up -d --build app

# --- database ---
POSTGRES_DB=ievent
POSTGRES_USER=ievent
# REQUIRED. Pick a strong local password.
POSTGRES_PASSWORD=change-me-strong

# --- app ---
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# --- seeding ---
# SEED_DEMO=true creates the demo organizer, user accounts and 8 showcase events (idempotent).
SEED_DEMO=true
# SEED_SCALE=N additionally generates N synthetic events for production-like volume (0 = off).
SEED_SCALE=0

# --- email ---
# MAIL_MODE=mailpit (local dev: view all mail at http://localhost:8025)
# MAIL_MODE=mailjet (production: SMTP via in-v3.mailjet.com using the keys below)
MAIL_MODE=mailpit
MAIL_FROM=no-reply@ievent.iq
MAILPIT_UI_PORT=8025
# Only needed when MAIL_MODE=mailjet:
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
# SMTP host/port are derived from MAIL_MODE by default; override only if needed:
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025

# --- Google integrations (all optional; features hide when unset) ---
# OAuth "Sign in with Google": create at console.cloud.google.com → Credentials → OAuth client (Web).
# Authorized redirect URI: ${APP_BASE_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Maps Embed API key (restrict to your domain): shows the real venue map on event pages.
GOOGLE_MAPS_API_KEY=
