# iEvent local environment — copy to .env and adjust. NEVER commit .env.
# Run everything with:  docker compose up -d --build app

# --- database ---
POSTGRES_DB=ievent
POSTGRES_USER=ievent
# REQUIRED. Pick a strong local password.
POSTGRES_PASSWORD=change-me-strong

# --- app ---
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# --- seeding ---
# SEED_DEMO=true creates the demo organizer, user accounts and 8 showcase events (idempotent).
# PRODUCTION: keep this false. The demo accounts have well-known passwords.
SEED_DEMO=true
# SEED_SCALE=N additionally generates N synthetic events for production-like volume (0 = off).
SEED_SCALE=0

# --- content pages ---
# Show the product screenshot slots on the learn/content pages (how it works, features,
# solutions, guides). Keep false until the images exist in
# src/main/resources/static/img/shots/ (filenames + sizes in the README there).
CONTENT_SCREENSHOTS=false

# --- email ---
# MAIL_MODE=mailpit (local dev: view all mail at http://localhost:8025)
# MAIL_MODE=mailjet (production: SMTP via in-v3.mailjet.com using the keys below)
MAIL_MODE=mailpit
MAIL_FROM=no-reply@ievent.iq
MAILPIT_UI_PORT=8025
# Only needed when MAIL_MODE=mailjet:
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
# SMTP host/port are derived from MAIL_MODE by default; override only if needed:
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025

# --- Google integrations (all optional; features hide when unset) ---
# OAuth "Sign in with Google": create at console.cloud.google.com → Credentials → OAuth client (Web).
# Authorized redirect URI: ${APP_BASE_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Maps Embed API key (restrict to your domain): shows the real venue map on event pages.
GOOGLE_MAPS_API_KEY=

# --- AI event-description writer (optional; the "Write it for me" button hides when unset) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Pexels stock-photo search (optional; the cover-picker's "search photos" tab hides when unset) ---
# Get a free key at pexels.com/api.
PEXELS_API_KEY=

# --- Auto-translate event copy (optional; no-op when unset) ---
# Cloud Translation API v2, API-key auth — enable it at console.cloud.google.com
# → APIs & Services → Cloud Translation API, then create an API key. When set,
# a host's title/summary/description/lineup are auto-translated to the other
# language (ar<->en) the moment they publish the event.
GOOGLE_TRANSLATE_API_KEY=

# --- Google Analytics + Search Console (both optional; hide/no-op when unset) ---
# GA4 property Measurement ID (looks like G-XXXXXXX) — adds the gtag.js snippet site-wide.
GA_MEASUREMENT_ID=
# Search Console "HTML tag" ownership-verification code — just the content=".." value,
# not the whole <meta> tag. See DEPLOY.md / the SEO guide for how to get one.
GOOGLE_SITE_VERIFICATION=

# --- Super-admin console (/admin) ---
# REQUIRED. A single shared password gating the platform-oversight console
# (view every host + stats, take down events, disable accounts). Not tied to
# any user account — pick something strong, rotate it if it ever leaks.
SUPER_ADMIN_PASSWORD=change-me-strong

# --- abuse protection ---
# Per-IP throttle on sign-in, password reset, admin sign-in, contact, newsletter and
# checkout submissions. Keep true; set false only for automated test runs.
RATE_LIMIT_ENABLED=true

# --- sessions (production) ---
# Signs "remember me" cookies. Generate once (openssl rand -hex 32) and keep it;
# empty = random key per restart, which just logs remembered users out on deploy.
REMEMBER_ME_KEY=
# Marks the session cookie Secure. docker-compose.staging.yml forces this to true
# behind Caddy/HTTPS; only set it here if your local setup also serves HTTPS.
# SESSION_COOKIE_SECURE=false

# --- backups (production, read by scripts/backup.sh) ---
# Off-site target for nightly dumps: an rclone remote (b2:ievent-backups) or an
# scp destination (backup@host:/srv/ievent). Empty = local ./backups only.
BACKUP_REMOTE=
